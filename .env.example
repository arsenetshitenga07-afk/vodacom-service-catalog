# ─── Connexion au backend (voir endpoints.json) ───────────────────────────

# URL de l'API. Si vide, le code utilise la valeur de repli déclarée dans
# `src/services/apiConfig.js` (URL Render du portail Vodacom).
#
# → Pour forcer une autre URL, décommentez et ajustez la ligne ci-dessous.
# → Doit se terminer par `/api` (les endpoints déclarés dans le code
#   commencent par `/auth/...` et `/services/...`, sans le préfixe `/api`).
# → Une URL absolue déclenchera un pre-flight CORS — le backend doit autoriser
#   l'origine du frontend.
#
# ⚠️ Vite n'expose au code client QUE les variables préfixées par VITE_.
# VITE_API_BASE_URL=https://catalogue-portail-interne-des.onrender.com/api

# Mode démo (données simulées dans le navigateur, aucun backend requis).
# - true  = mock local (pratique pour dev offline)
# - false = appels réels au backend (prod par défaut)
# Par défaut : `true` en dev, `false` en production.
VITE_USE_MOCK_API=true

# Adresse du backend en développement (serveur NestJS local).
# Le proxy Vite relaie `/api` vers cette cible en dev (`vite.config.js`).
VITE_API_PROXY_TARGET=http://localhost:3000

# ─── Fonctionnalités hors contrat endpoints.json ──────────────────────────
# En production, ces features sont ACTIVÉES par défaut (le backend les
# fournit). Pour les désactiver, passez la variable à `false` sur Vercel.
# En mode démo, elles sont toujours actives (le mock les supporte).
#
# Connexion en deux étapes avec code par e-mail (/auth/send-code + /auth/verify-code)
# VITE_FEATURE_OTP_LOGIN=true
# Changement de mot de passe (/auth/change-password)
# VITE_FEATURE_CHANGE_PASSWORD=true
# Champ « department » sur les services
# VITE_FEATURE_DEPARTMENTS=true
# Inscription publique de compte (/auth/register)
# VITE_FEATURE_SELF_SIGNUP=true
# Mot de passe oublié (/auth/forgot-password + /auth/reset-password)
# VITE_FEATURE_PASSWORD_RESET=true
