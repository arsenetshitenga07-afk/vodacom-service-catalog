# ─── Connexion au backend (voir endpoints.json) ───────────────────────────

# URL complète de l'API. En production, pointez vers votre backend (Render,
# Railway, NestJS, etc.) ou vers le même domaine Vercel si vous utilisez les
# serverless functions (`/api`). En développement local, laissez `/api` (le
# proxy Vite le relaiera vers VITE_API_PROXY_TARGET, pas de CORS).
API_BASE_URL=https://catalogue-portail-interne-des-appli-iota.vercel.app/api

# ⚠️ Vite n'expose au code client QUE les variables préfixées par VITE_.
# Si vous voulez surcharger API_BASE_URL via .env, déclarez donc la variable
# sous le nom VITE_API_BASE_URL — sa valeur primera sur la valeur par défaut
# codée en dur dans src/services/apiConfig.js.
# VITE_API_BASE_URL=https://catalogue-portail-interne-des-appli-iota.vercel.app/api

# true  = données simulées dans le navigateur (aucun backend requis)
# false = appels réels au backend Portal Vodacom API
VITE_USE_MOCK_API=true

# Adresse du backend en développement (serveur NestJS local)
VITE_API_PROXY_TARGET=http://localhost:3000

# Fonctionnalités hors endpoints.json : passer à true quand le backend les fournit.
# Connexion avec code par e-mail (POST /auth/send-code + POST /auth/verify-code)
VITE_FEATURE_OTP_LOGIN=false
# Changement de mot de passe (POST /auth/change-password)
VITE_FEATURE_CHANGE_PASSWORD=false
# Champ « department » sur les services
VITE_FEATURE_DEPARTMENTS=false
# Inscription publique de compte (POST /auth/register) — désactivée par défaut
VITE_FEATURE_SELF_SIGNUP=false
# Mot de passe oublié (POST /auth/forgot-password + POST /auth/reset-password)
VITE_FEATURE_PASSWORD_RESET=false
