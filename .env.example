# ─── Connexion au backend (voir endpoints.json) ───────────────────────────

# true  = données simulées dans le navigateur (aucun backend requis)
# false = appels réels au backend Portal Vodacom API
VITE_USE_MOCK_API=true

# Préfixe des appels. Garder « /api » : en développement, Vite le relaie vers
# VITE_API_PROXY_TARGET (pas de problème de CORS). En production, mettre l'URL
# complète, ex. https://portal.vodacom.com/api
VITE_API_BASE_URL=/api

# Adresse du backend en développement (serveur NestJS)
VITE_API_PROXY_TARGET=http://localhost:3000

# Fonctionnalités hors endpoints.json : passer à true quand le backend les fournit.
# Connexion avec code par e-mail (POST /auth/send-code + POST /auth/verify-code)
VITE_FEATURE_OTP_LOGIN=false
# Changement de mot de passe (POST /auth/change-password)
VITE_FEATURE_CHANGE_PASSWORD=false
# Champ « department » sur les services
VITE_FEATURE_DEPARTMENTS=false
